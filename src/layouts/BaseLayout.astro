---
import '../styles/global.css';
import Icons from '../components/Icons.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Dr. Ovide Decroly Wisnu Ardhi | Applied AI & Computer Vision",
  description = "Official Academic & Research Portal of Dr. Ovide Decroly Wisnu Ardhi, S.T., M.Eng. Applied AI, Computer Vision, YOLO, Deep Learning, and Digital Education."
} = Astro.props;

const currentPath = Astro.url.pathname;

const navItems = [
  { name: "Overview", href: "/" },
  { name: "Research", href: "/research" },
  { name: "Publications", href: "/publications" },
  { name: "Books", href: "/books" },
  { name: "Teaching", href: "/teaching" },
  { name: "Articles", href: "/blog" },
  { name: "About", href: "/about" },
];
---

<!doctype html>
<html lang="id" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Dr. Ovide Decroly Wisnu Ardhi, S.T., M.Eng." />
    <meta name="theme-color" content="#047857" />
    
    <!-- Google Fonts: Plus Jakarta Sans & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  </head>

  <body class="min-h-screen flex flex-col bg-slate-50/50 text-slate-800 antialiased font-sans">
    
    <!-- Header Navigation (Clean Swiss Flat Style) -->
    <header class="sticky top-0 z-50 bg-white border-b border-slate-200">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-6">
        
        <!-- Text-Only Modern Brand Mark (No image logo) -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-8 h-8 rounded-lg bg-emerald-700 text-white flex items-center justify-center font-mono font-extrabold text-xs tracking-wider shadow-xs">
            OD
          </div>
          <div class="flex flex-col">
            <span class="font-extrabold text-sm sm:text-base tracking-tight text-slate-900 group-hover:text-emerald-700 transition-colors">
              Dr. Ovide Decroly
            </span>
            <span class="text-[10px] font-mono text-emerald-800 font-semibold tracking-wider uppercase -mt-0.5">
              Applied AI Researcher
            </span>
          </div>
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-1">
          {navItems.map((item) => {
            const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
            return (
              <a
                href={item.href}
                class:list={[
                  "px-3 py-1.5 rounded-md text-xs font-semibold tracking-tight transition-all",
                  isActive
                    ? "bg-emerald-50 text-emerald-800 font-bold border border-emerald-200"
                    : "text-slate-600 hover:text-emerald-800 hover:bg-slate-100"
                ]}
              >
                {item.name}
              </a>
            );
          })}
        </nav>

        <!-- Right Action Button -->
        <div class="hidden sm:flex items-center gap-3">
          <a href="/about" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-bold rounded-md transition-colors shadow-xs">
            <span>Profile & CV</span>
            <Icons name="arrow-right" class="w-3.5 h-3.5" />
          </a>
        </div>

      </div>

      <!-- Mobile Horizontal Scroll Navigation -->
      <div class="md:hidden border-t border-slate-100 px-4 py-2 flex gap-1 overflow-x-auto bg-slate-50/80">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class:list={[
                "px-2.5 py-1 rounded text-xs font-semibold whitespace-nowrap transition-all",
                isActive
                  ? "bg-emerald-700 text-white font-bold"
                  : "text-slate-600 bg-white border border-slate-200"
              ]}
            >
              {item.name}
            </a>
          );
        })}
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Academic Minimal Footer -->
    <footer class="bg-white border-t border-slate-200 pt-12 pb-8 mt-16 text-slate-600">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 grid grid-cols-1 md:grid-cols-4 gap-8 mb-10">
        
        <div class="md:col-span-1">
          <div class="flex items-center gap-2 mb-2">
            <div class="w-6 h-6 rounded bg-emerald-700 text-white flex items-center justify-center font-mono font-bold text-[10px]">
              OD
            </div>
            <span class="font-bold text-sm text-slate-900">Dr. Ovide Decroly</span>
          </div>
          <p class="text-xs text-slate-500 leading-relaxed mb-3">
            S.T., M.Eng. • Applied AI Researcher in Computer Vision, Deep Learning, and Digital Education.
          </p>
          <a 
            href="https://github.com/ovidedecroly" 
            target="_blank" 
            rel="noopener" 
            class="inline-flex items-center gap-1 text-xs font-mono font-semibold text-emerald-800 hover:underline"
          >
            <span>github.com/ovidedecroly</span>
            <Icons name="external" class="w-3 h-3" />
          </a>
        </div>

        <div>
          <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-900 mb-3">Research Domains</h4>
          <ul class="space-y-1.5 text-xs">
            <li><a href="/research/plankton-visual-ai" class="hover:text-emerald-700 transition-colors">Microscopic Plankton AI</a></li>
            <li><a href="/blog/yolo-deteksi-objek" class="hover:text-emerald-700 transition-colors">Real-Time Object Detection</a></li>
            <li><a href="/research" class="hover:text-emerald-700 transition-colors">All Research Projects</a></li>
            <li><a href="/publications" class="hover:text-emerald-700 transition-colors">Published Papers</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-900 mb-3">Books & Curriculum</h4>
          <ul class="space-y-1.5 text-xs">
            <li><a href="/books/image-with-deep-learning" class="hover:text-emerald-700 transition-colors">Image with Deep Learning</a></li>
            <li><a href="/books/literasi-data-dan-teknologi-digital" class="hover:text-emerald-700 transition-colors">Literasi Data & Digital</a></li>
            <li><a href="/teaching/modul-ai-pertemuan-1" class="hover:text-emerald-700 transition-colors">Lecture Modules</a></li>
            <li><a href="/books" class="hover:text-emerald-700 transition-colors">All Books</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-900 mb-3">Academic Collaboration</h4>
          <p class="text-xs text-slate-500 mb-3 leading-relaxed">
            Open for research collaboration, keynote presentations, and academic consulting.
          </p>
          <a href="/about" class="text-xs font-bold text-emerald-800 hover:text-emerald-900 flex items-center gap-1">
            <span>View Full Academic Profile</span>
            <Icons name="arrow-right" class="w-3 h-3" />
          </a>
        </div>

      </div>

      <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-6 border-t border-slate-100 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-slate-400">
        <p>© {new Date().getFullYear()} Dr. Ovide Decroly Wisnu Ardhi. All rights reserved.</p>
        <p class="font-mono text-[11px]">Academic & Research Portfolio</p>
      </div>
    </footer>

  </body>
</html>
