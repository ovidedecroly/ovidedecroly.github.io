---
import BaseLayout from '../../layouts/BaseLayout.astro';

const publications = [
  {
    title: "AI-Based Decision Support and Computer Vision in Modern Higher Education",
    date: "2026",
    publisher: "Journal of Applied Artificial Intelligence & Education",
    desc: "A peer-reviewed study examining the implementation of computer vision pipelines and deep learning in scientific image analysis.",
    authors: "Dr. Ovide Decroly Wisnu Ardhi, et al."
  }
];
---

<BaseLayout title="Publications | Ovide Academy">
  <section class="bg-white border-b border-slate-200 py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <span class="flat-badge mb-2">Publikasi Ilmiah</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-2">
        Scholarly Publications & Papers
      </h1>
      <p class="text-base text-slate-600">
        Daftar publikasi jurnal internasional, prosiding konferensi, dan karya ilmiah Dr. Ovide Decroly Wisnu Ardhi.
      </p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <div class="space-y-4">
      {publications.map((pub) => (
        <div class="flat-card p-6">
          <div class="flex items-center gap-2 mb-2">
            <span class="font-mono text-xs text-emerald-800 font-bold bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">{pub.date}</span>
            <span class="text-xs text-slate-400">•</span>
            <span class="text-xs font-semibold text-slate-500">{pub.publisher}</span>
          </div>
          <h3 class="font-extrabold text-lg text-slate-900 mb-2 leading-snug">
            {pub.title}
          </h3>
          <p class="text-xs font-mono font-medium text-emerald-700 mb-3">
            {pub.authors}
          </p>
          <p class="text-xs text-slate-600 leading-relaxed">
            {pub.desc}
          </p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
