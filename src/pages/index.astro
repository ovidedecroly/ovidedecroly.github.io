---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icons from '../components/Icons.astro';

// Articles Data
const articles = [
  {
    title: "Dakwah Digital dan Artificial Intelligence",
    date: "09 Juni 2026",
    category: "Dakwah Digital",
    slug: "/blog/dakwah-digital-dan-ai",
    desc: "Refleksi awal tentang pemanfaatan kecerdasan buatan secara etis dalam dakwah digital dan penyebaran ilmu pengetahuan.",
    tags: ["Dakwah", "AI", "Etika Digital"]
  },
  {
    title: "YOLO untuk Deteksi Objek: Catatan Awal",
    date: "08 Juni 2026",
    category: "Computer Vision",
    slug: "/blog/yolo-deteksi-objek",
    desc: "Ringkasan praktis mengenai arsitektur YOLO sebagai model deteksi objek satu tahap berkecepatan tinggi.",
    tags: ["YOLO", "Object Detection", "Vision AI"]
  },
  {
    title: "Pengantar Artificial Intelligence",
    date: "07 Juni 2026",
    category: "AI & ML",
    slug: "/blog/pengantar-ai",
    desc: "Catatan pengantar mengenai konsep dasar Artificial Intelligence untuk mahasiswa dan pembelajar pemula.",
    tags: ["AI", "Machine Learning", "Deep Learning"]
  }
];

// Books Data (Monograph Format)
const books = [
  {
    title: "Literasi Data dan Teknologi Digital",
    status: "Draft",
    year: "2026",
    slug: "/books/literasi-data-dan-teknologi-digital",
    desc: "Buku rujukan pengantar literasi data, fondasi teknologi digital, dan etika kecerdasan buatan bagi mahasiswa perguruan tinggi.",
    pdf: "/pdf/buku-literasi-data.pdf"
  },
  {
    title: "Image with Deep Learning",
    status: "In Preparation",
    year: "2026",
    slug: "/books/image-with-deep-learning",
    desc: "Modul komprehensif mengenai pengolahan citra digital, convolutional neural networks, dan implementasi deteksi objek mutakhir.",
    pdf: "/pdf/buku-image-deep-learning.pdf"
  }
];

// Research Highlights Data
const researchItems = [
  {
    title: "AI-Based Visual Analysis for Plankton Images",
    date: "07 Juni 2026",
    category: "Marine Vision AI",
    slug: "/research/plankton-visual-ai",
    desc: "Deteksi dan klasifikasi otomatis mikroorganisme plankton pada citra mikroskopik menggunakan deep neural networks.",
    tags: ["Plankton", "YOLO", "Microscopy"]
  }
];

// Teaching Module Data
const teachingItems = [
  {
    title: "Modul AI Pertemuan 1: Dasar Kecerdasan Buatan",
    date: "07 Juni 2026",
    category: "Materi Kuliah",
    slug: "/teaching/modul-ai-pertemuan-1",
    desc: "Silabus, capaian pembelajaran, dan slide materi pengantar Artificial Intelligence untuk perkuliahan semester awal.",
    tags: ["AI", "Perkuliahan", "Modul"]
  }
];
---

<BaseLayout>
  <!-- Hero Section: Modern Minimalist Academic Layout -->
  <section class="bg-white border-b border-slate-200 py-14 lg:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Left Column: Title & Research Agenda -->
      <div class="lg:col-span-7">
        
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-emerald-50 border border-emerald-200 rounded-full text-xs font-mono font-bold text-emerald-800 mb-6">
          <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
          <span>Applied Artificial Intelligence & Computer Vision Lab</span>
        </div>

        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-[1.15] mb-5">
          Research in <span class="text-emerald-700">Visual Intelligence</span>, Object Detection, and Digital Learning.
        </h1>

        <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-8 max-w-xl">
          Portal akademik dan repositori riset <strong>Dr. Ovide Decroly Wisnu Ardhi, S.T., M.Eng.</strong> Menyajikan publikasi ilmiah, buku teks, modul kuliah, dan catatan riset terapan kecerdasan buatan.
        </p>

        <!-- Flat Button Row -->
        <div class="flex flex-wrap gap-3 mb-10">
          <a href="/research" class="inline-flex items-center gap-2 px-5 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs rounded-md shadow-xs transition-colors">
            <Icons name="eye" class="w-4 h-4" />
            <span>Research Projects</span>
            <Icons name="arrow-right" class="w-3.5 h-3.5" />
          </a>
          <a href="/books" class="inline-flex items-center gap-2 px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold text-xs rounded-md border border-slate-300 transition-colors">
            <Icons name="book" class="w-4 h-4" />
            <span>Books & Modules</span>
          </a>
          <a href="/blog" class="inline-flex items-center gap-2 px-5 py-2.5 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs rounded-md border border-slate-200 transition-colors">
            <Icons name="document" class="w-4 h-4" />
            <span>Articles</span>
          </a>
        </div>

        <!-- Metrics Matrix -->
        <div class="grid grid-cols-3 gap-6 pt-6 border-t border-slate-100">
          <div>
            <div class="text-xl font-mono font-extrabold text-emerald-800">4+</div>
            <div class="text-[11px] font-mono uppercase tracking-wider text-slate-500 mt-0.5">Research Domains</div>
          </div>
          <div>
            <div class="text-xl font-mono font-extrabold text-emerald-800">YOLO</div>
            <div class="text-[11px] font-mono uppercase tracking-wider text-slate-500 mt-0.5">Real-Time Detection</div>
          </div>
          <div>
            <div class="text-xl font-mono font-extrabold text-emerald-800">Open</div>
            <div class="text-[11px] font-mono uppercase tracking-wider text-slate-500 mt-0.5">Academic Access</div>
          </div>
        </div>

      </div>

      <!-- Right Column: Academic Metadata Box -->
      <div class="lg:col-span-5">
        <div class="bg-slate-50 border border-slate-200 rounded-xl p-6">
          
          <div class="pb-4 border-b border-slate-200 mb-4">
            <div class="text-[10px] font-mono uppercase tracking-widest text-emerald-800 font-bold mb-1">
              Researcher Profile
            </div>
            <h3 class="text-lg font-extrabold text-slate-900">
              Dr. Ovide Decroly Wisnu Ardhi
            </h3>
            <p class="text-xs text-slate-500 font-mono mt-0.5">
              S.T., M.Eng. • Applied AI Researcher
            </p>
          </div>

          <div class="space-y-3 text-xs mb-5">
            <div>
              <span class="font-mono text-slate-400 block text-[10px] uppercase">Specialization</span>
              <div class="flex flex-wrap gap-1.5 mt-1">
                <span class="px-2 py-0.5 bg-white border border-slate-200 rounded text-slate-700 font-medium text-[11px]">Computer Vision</span>
                <span class="px-2 py-0.5 bg-white border border-slate-200 rounded text-slate-700 font-medium text-[11px]">YOLO Architecture</span>
                <span class="px-2 py-0.5 bg-white border border-slate-200 rounded text-slate-700 font-medium text-[11px]">Deep Learning</span>
                <span class="px-2 py-0.5 bg-white border border-slate-200 rounded text-slate-700 font-medium text-[11px]">Academic Writing</span>
                <span class="px-2 py-0.5 bg-white border border-slate-200 rounded text-slate-700 font-medium text-[11px]">Digital Education</span>
              </div>
            </div>

            <div class="pt-2">
              <span class="font-mono text-slate-400 block text-[10px] uppercase">Current Active Focus</span>
              <p class="text-slate-700 font-medium mt-1 leading-relaxed">
                AI-driven microscopic visual analysis and object recognition for scientific specimen classification.
              </p>
            </div>
          </div>

          <div class="pt-3 border-t border-slate-200 flex justify-between items-center text-xs">
            <a href="https://github.com/ovidedecroly" target="_blank" rel="noopener" class="inline-flex items-center gap-1 text-emerald-800 font-mono font-bold hover:underline">
              <span>GitHub Profile</span>
              <Icons name="external" class="w-3 h-3" />
            </a>
            <a href="/about" class="inline-flex items-center gap-1 text-slate-600 hover:text-slate-900 font-bold">
              <span>Biography</span>
              <Icons name="arrow-right" class="w-3 h-3" />
            </a>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- Research Pillars (4 Flat Cards with SVG Icons) -->
  <section class="py-14 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-2 mb-8 pb-4 border-b border-slate-200">
        <div>
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-800">Core Disciplines</span>
          <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight mt-0.5">
            Research & Academic Focus
          </h2>
        </div>
        <a href="/about" class="text-xs font-bold text-emerald-800 hover:underline flex items-center gap-1">
          <span>Full Academic Details</span>
          <Icons name="arrow-right" class="w-3 h-3" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        
        <div class="bg-white border border-slate-200 rounded-lg p-5 flex flex-col justify-between hover:border-emerald-600 transition-colors">
          <div>
            <div class="w-9 h-9 rounded bg-emerald-50 text-emerald-700 flex items-center justify-center mb-3">
              <Icons name="eye" class="w-5 h-5" />
            </div>
            <h3 class="font-extrabold text-sm text-slate-900 mb-1.5">Computer Vision & YOLO</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-3">
              Real-time object detection models, image segmentation, and visual pattern recognition for biological and industrial imagery.
            </p>
          </div>
          <span class="text-[10px] font-mono font-bold text-emerald-800 uppercase tracking-wider">Vision AI • Detection</span>
        </div>

        <div class="bg-white border border-slate-200 rounded-lg p-5 flex flex-col justify-between hover:border-emerald-600 transition-colors">
          <div>
            <div class="w-9 h-9 rounded bg-emerald-50 text-emerald-700 flex items-center justify-center mb-3">
              <Icons name="cpu" class="w-5 h-5" />
            </div>
            <h3 class="font-extrabold text-sm text-slate-900 mb-1.5">Applied Machine Learning</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-3">
              Practical deep learning pipelines, decision support algorithms, automated classification, and edge AI deployment.
            </p>
          </div>
          <span class="text-[10px] font-mono font-bold text-emerald-800 uppercase tracking-wider">Deep Learning • Systems</span>
        </div>

        <div class="bg-white border border-slate-200 rounded-lg p-5 flex flex-col justify-between hover:border-emerald-600 transition-colors">
          <div>
            <div class="w-9 h-9 rounded bg-emerald-50 text-emerald-700 flex items-center justify-center mb-3">
              <Icons name="document" class="w-5 h-5" />
            </div>
            <h3 class="font-extrabold text-sm text-slate-900 mb-1.5">Academic Writing</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-3">
              Methodology for scholarly publications, structured literature reviews, scientific data synthesis, and journal publishing.
            </p>
          </div>
          <span class="text-[10px] font-mono font-bold text-emerald-800 uppercase tracking-wider">Publication • Methods</span>
        </div>

        <div class="bg-white border border-slate-200 rounded-lg p-5 flex flex-col justify-between hover:border-emerald-600 transition-colors">
          <div>
            <div class="w-9 h-9 rounded bg-emerald-50 text-emerald-700 flex items-center justify-center mb-3">
              <Icons name="academic" class="w-5 h-5" />
            </div>
            <h3 class="font-extrabold text-sm text-slate-900 mb-1.5">Digital & Islamic Education</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-3">
              Integration of digital literacy, ethical frameworks for artificial intelligence, and modernized educational technology.
            </p>
          </div>
          <span class="text-[10px] font-mono font-bold text-emerald-800 uppercase tracking-wider">EdTech • Literacy</span>
        </div>

      </div>

    </div>
  </section>

  <!-- Books & Monograph Showcase (Clean Flat Monograph Cards) -->
  <section class="py-14 sm:py-16 bg-white border-y border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-2 mb-8 pb-4 border-b border-slate-200">
        <div>
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-800">Academic Books</span>
          <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight mt-0.5">
            Books & Curriculum Modules
          </h2>
        </div>
        <a href="/books" class="text-xs font-bold text-emerald-800 hover:underline flex items-center gap-1">
          <span>All Publications</span>
          <Icons name="arrow-right" class="w-3 h-3" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {books.map((book) => (
          <div class="border border-slate-200 rounded-lg p-5 bg-slate-50/50 flex flex-col justify-between hover:border-emerald-600 transition-colors">
            <div>
              <div class="flex justify-between items-center text-xs mb-3">
                <span class="font-mono text-slate-500 font-semibold">{book.year}</span>
                <span class="px-2 py-0.5 bg-white text-emerald-800 border border-emerald-200 rounded text-[10px] font-mono font-bold uppercase">
                  {book.status}
                </span>
              </div>

              <h3 class="font-extrabold text-base text-slate-900 mb-2">
                <a href={book.slug} class="hover:text-emerald-700">
                  {book.title}
                </a>
              </h3>

              <p class="text-xs text-slate-600 leading-relaxed mb-4">
                {book.desc}
              </p>
            </div>

            <div class="flex gap-2 pt-3 border-t border-slate-200">
              <a href={book.slug} class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-100 text-slate-800 text-xs font-bold rounded border border-slate-200 transition-colors">
                <span>View Overview</span>
                <Icons name="arrow-right" class="w-3 h-3" />
              </a>
              {book.pdf && (
                <a href={book.pdf} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-bold rounded transition-colors">
                  <Icons name="download" class="w-3.5 h-3.5" />
                  <span>PDF Document</span>
                </a>
              )}
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Recent Articles & Scholarly Notes -->
  <section class="py-14 sm:py-16">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-2 mb-8 pb-4 border-b border-slate-200">
        <div>
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-800">Articles & Notes</span>
          <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight mt-0.5">
            Latest Writings & Technical Notes
          </h2>
        </div>
        <a href="/blog" class="text-xs font-bold text-emerald-800 hover:underline flex items-center gap-1">
          <span>All Articles</span>
          <Icons name="arrow-right" class="w-3 h-3" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {articles.map((item) => (
          <article class="bg-white border border-slate-200 rounded-lg p-5 flex flex-col justify-between hover:border-emerald-600 transition-colors">
            <div>
              <div class="flex justify-between items-center text-xs mb-2.5">
                <span class="font-mono text-slate-400 text-[11px]">{item.date}</span>
                <span class="text-[10px] font-mono font-bold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                  {item.category}
                </span>
              </div>
              <h3 class="font-extrabold text-sm text-slate-900 mb-2 leading-snug">
                <a href={item.slug} class="hover:text-emerald-700 transition-colors">
                  {item.title}
                </a>
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed mb-4">
                {item.desc}
              </p>
            </div>

            <div class="pt-3 border-t border-slate-100 flex justify-between items-center text-xs">
              <div class="flex gap-1">
                {item.tags.map(t => (
                  <span class="text-[10px] text-slate-500 font-mono">#{t}</span>
                ))}
              </div>
              <a href={item.slug} class="font-bold text-emerald-800 hover:underline inline-flex items-center gap-1">
                <span>Read</span>
                <Icons name="arrow-right" class="w-3 h-3" />
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- Academic Contact & Research Section -->
  <section class="py-12 bg-white border-t border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="border border-emerald-200 bg-emerald-50/50 rounded-xl p-6 sm:p-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-6">
        <div>
          <span class="text-[11px] font-mono uppercase tracking-wider text-emerald-800 font-bold">Academic Dialogue</span>
          <h3 class="text-xl font-extrabold text-slate-900 mt-1 mb-1">
            Research Collaboration & Keynote Inquiries
          </h3>
          <p class="text-xs text-slate-600 max-w-xl leading-relaxed">
            Interested in joint research on computer vision, keynote presentations on applied AI, or curriculum development? Get in touch for scholarly cooperation.
          </p>
        </div>
        <a href="/about" class="px-4 py-2.5 bg-emerald-800 hover:bg-emerald-900 text-white font-bold text-xs rounded-md shadow-xs transition-colors shrink-0 flex items-center gap-2">
          <span>Academic Contact</span>
          <Icons name="arrow-right" class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
