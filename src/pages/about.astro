---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About | Dr. Ovide Decroly Wisnu Ardhi">
  <section class="bg-white border-b border-slate-200 py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <span class="flat-badge mb-2">Profil Akademis</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
        Dr. Ovide Decroly Wisnu Ardhi, S.T., M.Eng.
      </h1>
      <p class="text-base text-slate-600 leading-relaxed">
        Applied AI Researcher focusing on Computer Vision, Deep Learning, Academic Writing, and Digital Education.
      </p>
    </div>
  </section>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <div class="prose prose-slate max-w-none space-y-8 text-slate-700 leading-relaxed">
      
      <div class="p-6 bg-emerald-50/60 border border-emerald-200 rounded-2xl">
        <h2 class="text-lg font-bold text-emerald-900 mb-2">Tentang Ovide Academy</h2>
        <p class="text-sm text-emerald-950 leading-relaxed">
          <strong>Ovide Academy</strong> merupakan platform akademik pribadi yang dirancang untuk mengorganisasi dan membagikan catatan riset, modul pengajaran, artikel blog, buku teks, dan gagasan penerapan Artificial Intelligence (AI) di masyarakat.
        </p>
      </div>

      <div>
        <h2 class="text-xl font-extrabold text-slate-900 border-b border-slate-200 pb-2 mb-4">
          Fokus & Minat Riset
        </h2>
        <p class="text-sm text-slate-600 leading-relaxed mb-4">
          Fokus utama mencakup riset kecerdasan visual (visual intelligence) dan rekayasa deep learning:
        </p>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
          <li class="p-3 bg-white border border-slate-200 rounded-xl flex items-center gap-2">
            <span class="text-emerald-600 font-bold">✓</span>
            <span>Applied Artificial Intelligence</span>
          </li>
          <li class="p-3 bg-white border border-slate-200 rounded-xl flex items-center gap-2">
            <span class="text-emerald-600 font-bold">✓</span>
            <span>Computer Vision & Object Detection (YOLO)</span>
          </li>
          <li class="p-3 bg-white border border-slate-200 rounded-xl flex items-center gap-2">
            <span class="text-emerald-600 font-bold">✓</span>
            <span>Deep Learning & Microscopic Image Analysis</span>
          </li>
          <li class="p-3 bg-white border border-slate-200 rounded-xl flex items-center gap-2">
            <span class="text-emerald-600 font-bold">✓</span>
            <span>Academic Writing & Research Publication</span>
          </li>
          <li class="p-3 bg-white border border-slate-200 rounded-xl flex items-center gap-2">
            <span class="text-emerald-600 font-bold">✓</span>
            <span>Digital Education & AI Literacy</span>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="text-xl font-extrabold text-slate-900 border-b border-slate-200 pb-2 mb-4">
          Kontak & Tautan Akademik
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a href="https://github.com/ovidedecroly" target="_blank" rel="noopener" class="flat-card p-4 flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-slate-900 text-white flex items-center justify-center font-bold">
              GH
            </div>
            <div>
              <div class="font-extrabold text-sm text-slate-900">GitHub Repository</div>
              <div class="text-xs text-slate-500">github.com/ovidedecroly</div>
            </div>
          </a>
          <a href="https://ovidedecroly.github.io" class="flat-card p-4 flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-emerald-600 text-white flex items-center justify-center font-bold">
              WEB
            </div>
            <div>
              <div class="font-extrabold text-sm text-slate-900">Personal Website</div>
              <div class="text-xs text-slate-500">ovidedecroly.github.io</div>
            </div>
          </a>
        </div>
      </div>

    </div>
  </article>
</BaseLayout>
