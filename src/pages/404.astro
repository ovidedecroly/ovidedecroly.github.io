---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Halaman Tidak Ditemukan | Ovide Academy">
  <div class="max-w-xl mx-auto px-4 py-24 text-center">
    <span class="flat-badge mb-3">404 Error</span>
    <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 mb-3">
      Halaman Tidak Ditemukan
    </h1>
    <p class="text-sm text-slate-600 mb-6 leading-relaxed">
      Halaman atau dokumen akademik yang Anda cari mungkin telah dipindahkan atau tautannya berubah.
    </p>
    <a href="/" class="flat-btn-primary">
      Kembali ke Beranda
    </a>
  </div>
</BaseLayout>
