---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icons from '../../components/Icons.astro';

const researchProjects = [
  {
    title: "AI-Based Visual Analysis for Plankton Images",
    date: "07 Juni 2026",
    category: "Bioenvironmental Informatics",
    slug: "/research/plankton-visual-ai",
    desc: "Deteksi dan klasifikasi plankton otomatis pada citra mikroskopik menggunakan deep learning dan arsitektur YOLO mutakhir untuk pemantauan ekosistem perairan.",
    tags: ["Bioinformatics", "Plankton", "YOLO", "Microscopy", "Deep Learning"]
  }
];
---

<BaseLayout title="Research Projects | Dr. Ovide Decroly">
  <section class="bg-white border-b border-slate-200 py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-800">Laboratorium & Riset</span>
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mt-1 mb-2">
        Research Projects & Laboratories
      </h1>
      <p class="text-sm text-slate-600 max-w-2xl leading-relaxed">
        Eksplorasi penelitian terapan di bidang Bioenvironmental Informatics, Computer Vision, YOLO, dan kecerdasan visual ilmiah.
      </p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {researchProjects.map((item) => (
        <article class="bg-white border border-slate-200 rounded-lg p-6 flex flex-col justify-between hover:border-emerald-600 transition-colors">
          <div>
            <div class="flex justify-between items-center text-xs mb-3">
              <span class="font-mono text-slate-400 font-semibold">{item.date}</span>
              <span class="px-2.5 py-0.5 bg-emerald-50 text-emerald-800 font-bold rounded font-mono text-[10px] border border-emerald-200">
                {item.category}
              </span>
            </div>
            <h3 class="font-extrabold text-lg text-slate-900 mb-2 leading-snug">
              <a href={item.slug} class="hover:text-emerald-700 transition-colors">
                {item.title}
              </a>
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              {item.desc}
            </p>
          </div>

          <div class="pt-4 border-t border-slate-100 flex justify-between items-center">
            <div class="flex gap-1.5 flex-wrap">
              {item.tags.map(t => (
                <span class="text-[10px] font-mono bg-slate-50 text-slate-600 px-1.5 py-0.5 rounded border border-slate-200">
                  #{t}
                </span>
              ))}
            </div>
            <a href={item.slug} class="text-xs font-bold text-emerald-800 hover:underline inline-flex items-center gap-1">
              <span>View Research Note</span>
              <Icons name="arrow-right" class="w-3.5 h-3.5" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
