---

<BaseLayout title="Curriculum Vitae | Dr. Ovide Decroly Wisnu Ardhi">
  
  <!-- Export PDF / Print Action Header (Hidden on Print) -->
  <div class="bg-white border-b border-slate-200 py-4 print:hidden">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row justify-between items-center gap-4">
      <div>
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-800">Dokumen Resmi</span>
        <h1 class="text-lg font-extrabold text-slate-900">Curriculum Vitae — Dr. Ovide Decroly Wisnu Ardhi</h1>
      </div>
      <button 
        onclick="window.print()" 
        class="inline-flex items-center gap-2 px-5 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs rounded-md shadow-sm transition-all cursor-pointer"
      >
        <Icons name="download" class="w-4 h-4" />
        <span>Export / Cetak PDF</span>
      </button>
    </div>
  </div>

  <!-- Main CV Document Container -->
  <main class="max-w-5xl mx-auto px-4 sm:px-8 py-8 sm:py-12 print:p-0 print:max-w-full">
    
    <div class="bg-white border border-slate-200 print:border-none rounded-xl p-8 sm:p-12 shadow-xs print:shadow-none space-y-10">
      
      <!-- Header Section -->
      <div class="border-b-2 border-slate-900 pb-6">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          {cvData.name}
        </h2>
        <div class="text-xs font-mono uppercase font-bold text-emerald-800 tracking-widest mt-1 mb-2">
          {cvData.title}
        </div>
        <p class="text-xs font-semibold text-slate-700">
          {cvData.institution}
        </p>
        <p class="text-xs text-slate-600 mb-3">
          {cvData.faculty}
        </p>
        
        <div class="flex flex-wrap gap-x-4 gap-y-1 text-xs font-mono text-slate-600 pt-2 border-t border-slate-200">
          <span>Email: <a href={`mailto:${cvData.email}`} class="text-emerald-800 font-bold hover:underline">{cvData.email}</a></span>
          <span>•</span>
          <span>Telepon: <span class="text-slate-800 font-semibold">{cvData.phone}</span></span>
          <span>•</span>
          <span>Scopus Author ID: <a href={cvData.scopusUrl} target="_blank" rel="noopener" class="text-emerald-800 font-bold hover:underline">{cvData.scopusId}</a></span>
          <span>•</span>
          <span><a href={cvData.scholarUrl} target="_blank" rel="noopener" class="text-emerald-800 font-bold hover:underline">Google Scholar</a></span>
        </div>

        <div class="flex flex-wrap gap-x-4 gap-y-1 text-[11px] font-mono text-slate-500 mt-2">
          <span>NUPTK: {cvData.nuptk}</span>
          <span>|</span>
          <span>NIDN: {cvData.nidn}</span>
          <span>|</span>
          <span>NIP: {cvData.nip}</span>
        </div>
      </div>

      <!-- Profil Profesional -->
      <div>
        <h3 class="text-base font-extrabold text-slate-900 uppercase tracking-wider mb-3 flex items-center gap-2">
          <span>Profil Profesional</span>
        </h3>
        <p class="text-xs text-slate-700 leading-relaxed text-justify">
          {cvData.profile}
        </p>
      </div>

      <!-- Bidang Kompetensi -->
      <div>
        <h3 class="text-base font-extrabold text-slate-900 uppercase tracking-wider mb-3">
          Bidang Kompetensi
        </h3>
        <div class="border border-slate-200 rounded-lg overflow-hidden">
          <table class="w-full text-xs text-left">
            <tbody class="divide-y divide-slate-200">
              {cvData.competencies.map(item => (
                <tr class="divide-x divide-slate-200">
                  <td class="w-1/3 p-3 font-bold text-slate-900 bg-slate-50/70 align-top">
                    {item.title}
                  </td>
                  <td class="p-3 text-slate-700 leading-relaxed">
                    {item.desc}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Pengalaman Profesional dan Kelembagaan -->
      <div>
        <h3 class="text-base font-extrabold text-slate-900 uppercase tracking-wider mb-3">
          Pengalaman Profesional dan Kelembagaan
        </h3>
        <div class="space-y-4 text-xs">
          {cvData.experience.map(exp => (
            <div class="border-l-2 border-emerald-700 pl-4 py-1">
              <h4 class="font-extrabold text-slate-900 text-sm">{exp.role}</h4>
              <p class="font-semibold text-emerald-800 mb-1">{exp.org}</p>
              <p class="text-slate-600 leading-relaxed text-justify">{exp.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Pendidikan -->
      <div>
        <h3 class="text-base font-extrabold text-slate-900 uppercase tracking-wider mb-3">
          Pendidikan
        </h3>
        <div class="border border-slate-200 rounded-lg overflow-hidden">
          <table class="w-full text-xs text-left">
            <tbody class="divide-y divide-slate-200">
              {cvData.education.map(edu => (
                <tr class="divide-x divide-slate-200">
                  <td class="w-28 p-3 font-mono font-bold text-emerald-800 bg-slate-50/70 align-top">
                    {edu.period}
                  </td>
                  <td class="p-3">
                    <span class="font-extrabold text-slate-900 block">{edu.degree} | {edu.univ}</span>
                    <span class="text-slate-600 text-xs italic mt-0.5 block">{edu.thesis}</span>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Rekam Jejak Penelitian yang Diterima dan Didanai -->
      <div>
        <h3 class="text-base font-extrabold text-slate-900 uppercase tracking-wider mb-3">
          Rekam Jejak Penelitian yang Diterima dan Didanai
        </h3>
        <div class="border border-slate-200 rounded-lg overflow-x-auto">
          <table class="w-full text-xs text-left">
            <thead class="bg-slate-900 text-white font-mono text-[11px] uppercase">
              <tr>
                <th class="p-2.5 w-16">Tahun</th>
                <th class="p-2.5">Judul dan Skema</th>
                <th class="p-2.5 w-24">Peran</th>
                <th class="p-2.5 w-28">Dana</th>
                <th class="p-2.5 w-36">Kontrak</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              {cvData.researchTrack.map((item, idx) => (
                <tr class={idx % 2 === 0 ? "bg-white" : "bg-slate-50/50"}>
                  <td class="p-2.5 font-mono font-bold text-slate-800 align-top">{item.year}</td>
                  <td class="p-2.5 align-top">
