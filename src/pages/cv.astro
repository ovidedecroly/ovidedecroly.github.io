              <p class="text-slate-600 leading-relaxed">{h.desc}</p>
            </li>
          ))}
        </ul>
      </div>

      <!-- Publikasi Terpilih -->
      <div>
        <h3 class="text-base font-extrabold text-slate-900 uppercase tracking-wider mb-3">
