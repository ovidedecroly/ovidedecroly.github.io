---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Literasi Data dan Teknologi Digital | Ovide Academy">
  <section class="bg-white border-b border-slate-200 py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <a href="/books" class="text-xs font-bold text-emerald-700 hover:text-emerald-800 mb-4 inline-block">&larr; Kembali ke Daftar Buku</a>
      <div class="flex items-center gap-2 mb-2">
        <span class="px-2.5 py-0.5 bg-emerald-100 text-emerald-900 border border-emerald-300 font-mono text-[10px] font-bold rounded uppercase">Draft</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">
        Literasi Data dan Teknologi Digital
      </h1>
      <p class="text-base text-slate-600 leading-relaxed">
        An introductory book on data literacy and digital technology for students.
      </p>
    </div>
  </section>

  <article class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-start mb-10 pb-8 border-b border-slate-200">
      <div class="md:col-span-4 bg-emerald-50/70 border border-emerald-200 rounded-2xl p-6 flex items-center justify-center">
        <img 
          src="/images/book-literasi-data.svg" 
          alt="Cover Literasi Data dan Teknologi Digital"
          class="w-full max-h-64 object-contain rounded"
        />
      </div>

      <div class="md:col-span-8 flex flex-col justify-between">
        <div>
          <h3 class="text-lg font-bold text-slate-900 mb-2">Informasi Buku</h3>
          <p class="text-sm text-slate-600 leading-relaxed mb-4">
            Buku ini disusun oleh <strong>Dr. Ovide Decroly Wisnu Ardhi, S.T., M.Eng.</strong> sebagai bahan pembelajaran dasar untuk mengenalkan konsep data, etika digital, berpikir komputasional, dan peran artificial intelligence kepada mahasiswa dan masyarakat luas.
          </p>
        </div>

        <div class="flex gap-3">
          <a href="/pdf/buku-literasi-data.pdf" target="_blank" rel="noopener" class="flat-btn-primary">
            📄 Unduh Draft PDF
          </a>
          <a href="/books" class="flat-btn-outline">
            Daftar Buku Lainnya
          </a>
        </div>
      </div>
    </div>

    <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed space-y-6">
      <h2 class="text-xl font-extrabold text-slate-900 border-b border-slate-200 pb-2">
        Pokok Bahasan Utama
      </h2>
      <ul class="space-y-2 list-disc pl-6 text-sm">
        <li>Pengenalan Konsep Data, Informasi, dan Pengetahuan</li>
        <li>Ekosistem Teknologi Digital dan Transformasi Era Modern</li>
        <li>Etika Penggunaan AI dan Keamanan Data Pribadi</li>
        <li>Dasar Analisis Data untuk Pengambilan Keputusan</li>
        <li>Literasi AI untuk Generasi Muda</li>
      </ul>
    </div>
  </article>
</BaseLayout>
