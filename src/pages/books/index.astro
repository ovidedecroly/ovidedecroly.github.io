---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icons from '../../components/Icons.astro';

const books = [
  {
    title: "Literasi Data dan Teknologi Digital",
    status: "Draft",
    year: "2026",
    slug: "/books/literasi-data-dan-teknologi-digital",
    desc: "Buku pengantar mengenai pemahaman data, keamanan informasi, berpikir analitis, serta implikasi etis kecerdasan buatan bagi generasi akademisi modern.",
    pdf: "/pdf/buku-literasi-data.pdf",
    topics: ["Data Literacy", "Digital Ethics", "AI Basics", "Analytical Thinking"]
  },
  {
    title: "Image with Deep Learning",
    status: "In Preparation",
    year: "2026",
    slug: "/books/image-with-deep-learning",
    desc: "Buku rujukan teknis mengenai teori pemrosesan citra digital, arsitektur convolutional neural networks (CNN), dan pipeline deteksi objek mutakhir berbasis YOLO.",
    pdf: "/pdf/buku-image-deep-learning.pdf",
    topics: ["Computer Vision", "Convolutional Networks", "YOLO Architecture", "Segmentation"]
  }
];
---

<BaseLayout title="Books & Publications | Dr. Ovide Decroly">
  <section class="bg-white border-b border-slate-200 py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-800">Academic Monographs</span>
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mt-1 mb-2">
        Books & Learning Modules
      </h1>
      <p class="text-sm text-slate-600 max-w-2xl leading-relaxed">
        Buku rujukan ilmiah, modul pembelajaran mandiri, dan buku ajar yang disusun oleh Dr. Ovide Decroly Wisnu Ardhi untuk mendukung perkuliahan dan riset terapan.
      </p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {books.map((book) => (
        <div class="bg-white border border-slate-200 rounded-lg p-6 flex flex-col justify-between hover:border-emerald-600 transition-colors">
          <div>
            <div class="flex justify-between items-center text-xs mb-3">
              <span class="font-mono text-slate-400 font-semibold">{book.year}</span>
              <span class="px-2 py-0.5 bg-emerald-50 text-emerald-800 border border-emerald-200 rounded font-mono text-[10px] font-bold uppercase">
                {book.status}
              </span>
            </div>

            <h3 class="font-extrabold text-lg text-slate-900 mb-2 leading-snug">
              <a href={book.slug} class="hover:text-emerald-700 transition-colors">
                {book.title}
              </a>
            </h3>

            <p class="text-xs text-slate-600 leading-relaxed mb-4">
              {book.desc}
            </p>

            <div class="flex flex-wrap gap-1.5 mb-6">
              {book.topics.map(t => (
                <span class="text-[10px] font-mono bg-slate-50 text-slate-600 px-2 py-0.5 rounded border border-slate-200">
                  {t}
                </span>
              ))}
            </div>
          </div>

          <div class="flex gap-2 pt-4 border-t border-slate-100 text-xs">
            <a href={book.slug} class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-800 font-bold rounded transition-colors">
              <span>Overview</span>
              <Icons name="arrow-right" class="w-3.5 h-3.5" />
            </a>
            {book.pdf && (
              <a href={book.pdf} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-emerald-700 hover:bg-emerald-800 text-white font-bold rounded transition-colors">
                <Icons name="download" class="w-3.5 h-3.5" />
                <span>Download PDF</span>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
