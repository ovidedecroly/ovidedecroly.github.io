---
import BaseLayout from '../../layouts/BaseLayout.astro';

const books = [
  {
    title: "Literasi Data dan Teknologi Digital",
    status: "Draft",
    cover: "/images/book-literasi-data.svg",
    slug: "/books/literasi-data-dan-teknologi-digital",
    desc: "An introductory book on data literacy and digital technology for students. Membahas prinsip dasar pemahaman data, etika teknologi, dan analisis digital modern.",
    pdf: "/pdf/buku-literasi-data.pdf"
  },
  {
    title: "Image with Deep Learning",
    status: "In Preparation",
    cover: "/images/book-image-deep-learning.svg",
    slug: "/books/image-with-deep-learning",
    desc: "A book or module about image processing, deep learning, and object detection. Disusun sebagai buku rujukan teknis computer vision.",
    pdf: "/pdf/buku-image-deep-learning.pdf"
  }
];
---

<BaseLayout title="Books | Ovide Academy">
  <section class="bg-white border-b border-slate-200 py-12">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <span class="flat-badge mb-2">Publikasi & Teks</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-2">
        Books & Learning Modules
      </h1>
      <p class="text-base text-slate-600">
        Buku rujukan ilmiah, modul pembelajaran mandiri, dan buku ajar yang disusun oleh Dr. Ovide Decroly Wisnu Ardhi.
      </p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {books.map((book) => (
        <div class="flat-card p-6 flex flex-col justify-between">
          <div>
            <div class="w-full bg-emerald-50/70 border border-emerald-200/80 rounded-xl p-6 mb-5 flex items-center justify-center">
              <img 
                src={book.cover} 
                alt={book.title} 
                class="max-h-48 w-auto object-contain rounded"
              />
            </div>

            <span class="inline-block px-2.5 py-0.5 bg-emerald-100 text-emerald-900 border border-emerald-300 font-mono text-[10px] font-bold rounded uppercase mb-2">
              {book.status}
            </span>

            <h3 class="font-extrabold text-lg text-slate-900 mb-2 leading-snug">
              <a href={book.slug} class="hover:text-emerald-600 transition-colors">
                {book.title}
              </a>
            </h3>

            <p class="text-xs text-slate-600 leading-relaxed mb-6">
              {book.desc}
            </p>
          </div>

          <div class="flex gap-2 pt-4 border-t border-slate-100">
            <a href={book.slug} class="flat-btn-secondary !py-1.5 !px-3.5 !text-xs">
              Detail Buku &rarr;
            </a>
            {book.pdf && (
              <a href={book.pdf} target="_blank" rel="noopener" class="flat-btn-primary !py-1.5 !px-3.5 !text-xs">
                📄 Unduh PDF
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
